{
  "version": "0.17-0",
  "auth": {
    "enabled": true,
    "cookie_secure": true
  },
  "tls": {
    "enabled": true
  },
  "birdseye": {
    "enabled": true,
    "mode": "objects",
    "quality": 8
  },
  "go2rtc": {
    "streams": {
      "Camera_Alpha": {},
      "Camera_Alpha_sub": {},
      "Camera_Alpha_audio": {},
      "Camera_Beta": {},
      "Camera_Beta_sub": {},
      "Camera_Gamma": {},
      "Camera_Gamma_sub": {},
      "Camera_Delta": {},
      "Camera_Delta_sub": {},
      "Camera_Epsilon": {},
      "Camera_Epsilon_sub": {}
    }
  },
  "cameras": {
    "Camera_Alpha": {
      "enabled": true,
      "live": {
        "streams": {
          "Main with audio": "Camera_Alpha_audio",
          "Main": "Camera_Alpha",
          "Low bandwidth": "Camera_Alpha_sub"
        }
      },
      "ui": {
        "order": 0
      }
    },
    "Camera_Beta": {
      "enabled": true,
      "live": {
        "streams": {
          "Main": "Camera_Beta",
          "Low bandwidth": "Camera_Beta_sub"
        }
      },
      "ui": {
        "order": 1
      }
    },
    "Camera_Gamma": {
      "enabled": true,
      "live": {
        "streams": {
          "Main": "Camera_Gamma",
          "Low bandwidth": "Camera_Gamma_sub"
        }
      },
      "ui": {
        "order": 2
      }
    },
    "Camera_Delta": {
      "enabled": true,
      "live": {
        "streams": {
          "Main": "Camera_Delta",
          "Low bandwidth": "Camera_Delta_sub"
        }
      },
      "ui": {
        "order": 3
      }
    },
    "Camera_Epsilon": {
      "enabled": true,
      "live": {
        "streams": {
          "Main": "Camera_Epsilon",
          "Low bandwidth": "Camera_Epsilon_sub"
        }
      },
      "ui": {
        "order": 4
      }
    }
  }
}
